# ========================================================
# AgriVoice AI Assistant - Environment Configuration Template
# ========================================================

# Voice API Key (For Cloud Speech-to-Text Voice Commands)
VOICE_API_KEY=your_voice_api_key_here

# Gemini API Key (Required ONLY for Smart Online Mode fallback)
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here


# Smart Mode Selection:
# - "off"  : Pure offline demo mode (always uses local GGUF model)
# - "auto" : Hybrid mode (evaluates response confidence / retrieval and internet before trying Gemini)
# - "on"   : Online priority mode (always tries Gemini first if internet is available)
SMART_MODE=auto

# Local GGUF Model Path (Relative to project root or absolute)
LOCAL_MODEL_PATH=models/llama-3.2-3b-instruct-q4_k_m.gguf
LLM_CONTEXT_SIZE=2048
LLM_THREADS=4

# Voice Models Configuration (Offline)
WHISPER_MODEL_SIZE=base.en
PIPER_VOICE_MODEL=models/en_US-lessac-medium.onnx
PIPER_VOICE_CONFIG=models/en_US-lessac-medium.onnx.json

# Server Settings
HOST=127.0.0.1
PORT=8000
